# Copie este arquivo para .env.local (desenvolvimento) ou cadastre as variáveis na Vercel.

# --- Supabase (opcional: o app já aponta para o projeto oficial) -------------
# Supabase → Project Settings → API (ou "Connect"). A chave anon/publishable é pública
# por natureza: os dados ficam protegidos pelas políticas RLS do banco.
# NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-ou-publishable

# --- Professor de IA (necessário para conversar) ----------------------------
# Qualquer API compatível com OpenAI. Padrão: Groq (plano gratuito).
# NUNCA use o prefixo NEXT_PUBLIC_ nestas chaves: elas ficam só no servidor.
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-120b

# --- Reconhecimento de voz (opcional) ---------------------------------------
# Se vazio, usa a mesma chave/endereço da IA acima (Groq Whisper).
STT_API_KEY=
STT_BASE_URL=
STT_MODEL=whisper-large-v3-turbo
